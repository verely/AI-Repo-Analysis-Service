# ── Open AI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# ── Token budget ───────────────────────────────────────────────────────────────
# Raised to 32K — covers 99%+ of human-written READMEs without truncation.
# Cost note: prefill is parallelised; 32K is ~2x slower than 12K, not 2.7x.
QUICK_MODE_MAX_TOKENS=32000
# Hard ceiling — never send more than this regardless of the above.
# Protects against auto-generated READMEs (changelogs, API docs) that can be 100K+.
ABSOLUTE_MAX_INPUT_TOKENS=50000
PROMPT_OVERHEAD_TOKENS=600
MAX_OUTPUT_TOKENS=800

# ── Deep mode ──────────────────────────────────────────────────────────────────
DEEP_MODE_CHUNK_SIZE=6000
DEEP_MODE_MAX_CHUNKS=5
# Max concurrent LLM calls for chunk processing.
# Lower to 1 if you hit 429 rate limits from LLMProvider.
DEEP_CONCURRENT_LLM_CALLS=3

# ── Tier 2 fetch (deep mode only) ─────────────────────────────────────────────
ENTRY_POINT_MAX_FILES=4       # max entry point files to read
ENTRY_POINT_MAX_LINES=60      # lines to read per file
TREE_MAX_ENTRIES=120          # max file paths to include in prompt

# ── HTTP / reliability ─────────────────────────────────────────────────────────
GITHUB_TIMEOUT=10.0
LLM_TIMEOUT=60.0
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.5
